+// key. These are delivered once to NSTextInputClient, never as fake HID presses.
+void AKSetTextCommit(id event, NSString *text);
+BOOL AKDeliverTextCommit(id event, id client);
 // AppKit key-binding result delivered to the original NSTextInputClient.
