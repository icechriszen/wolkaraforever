+static char AKTextCommitKey;
+void AKSetTextCommit(id event, NSString *text) {
+    if (event && text.length)
+        objc_setAssociatedObject(event, &AKTextCommitKey, [text copy], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+BOOL AKDeliverTextCommit(id event, id client) {
+    id value = objc_getAssociatedObject(event, &AKTextCommitKey);
+    if (!value) return NO;
+    // Keep a consumed marker so a peeked event later dequeued/dispatched cannot
+    // insert twice or escape as the sentinel key. Clear text before callbacks,
+    // including re-entrant event processing in a text client.
+    if (value == NSNull.null) return YES;
+    objc_setAssociatedObject(event, &AKTextCommitKey, NSNull.null, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    NSString *text = value;
+    SEL insert = NSSelectorFromString(@"insertText:replacementRange:");
+    BOOL modern = [client respondsToSelector:insert];
+    BOOL legacy = !modern && [client respondsToSelector:NSSelectorFromString(@"insertText:")];
+    static unsigned logged;
+    if (logged < 16) {
+        logged++;
+        AKLog(@"text commit: units=%lu modern=%d legacy=%d", (unsigned long)text.length, modern, legacy);
+    }
+    if (modern)
+        ((void (*)(id,SEL,id,NSRange))[client methodForSelector:insert])(client,insert,text,NSMakeRange(NSNotFound,0));
+    else if (legacy) {
+        insert = NSSelectorFromString(@"insertText:");
+        ((void (*)(id,SEL,id))[client methodForSelector:insert])(client,insert,text);
+    }
+    return YES;
+}
