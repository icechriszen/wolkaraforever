 @interface InputClient : NSObject
 @property(copy) NSString *text, *command;
 @property NSRange range;
+@property unsigned insertions;
 @end
 @implementation InputClient
-- (void)insertText:(id)text replacementRange:(NSRange)range { self.text=text;self.range=range; }
+- (void)insertText:(id)text replacementRange:(NSRange)range { self.text=text;self.range=range;self.insertions++; }
 - (void)doCommandBySelector:(SEL)selector { self.command=NSStringFromSelector(selector); }
+@end
+@interface LegacyInputClient : NSObject
+@property(copy) NSString *text;
+@property unsigned insertions;
+@end
+@implementation LegacyInputClient
+- (void)insertText:(id)text { self.text=text; self.insertions++; }
+@end
+@interface OrderedInputClient : NSObject
+@property BOOL focused;
+@property(copy) NSString *draft, *submitted;
+@end
+@implementation OrderedInputClient
+- (void)insertText:(id)text replacementRange:(NSRange)range {
+    assert(range.location == NSNotFound && range.length == 0);
+    if (self.focused) self.draft = [self.draft stringByAppendingString:text];
+}
+- (void)rawKey:(unsigned short)code text:(NSString *)text {
+    if (code == 111) { self.focused=YES; self.draft=@""; }
+    else if (code == 36) { self.submitted=self.draft; self.focused=NO; }
+    else if (code < 128 && self.focused) self.draft=[self.draft stringByAppendingString:text];
+    // A raw-key client has no key at position 255. Text requires its text API.
+}
 @end
