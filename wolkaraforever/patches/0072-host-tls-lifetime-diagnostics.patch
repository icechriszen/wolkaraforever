# Opt-in diagnostics for this runtime's TLS storage lifetime.
# Records allocation/release metadata only; preserves the original allocator and
# destructor behavior. No guest memory contents, stacks, instructions or debugger.
# Disabled unless --host-lifetime-diagnostics or WK_HOST_DIAGNOSTICS=1 is explicit.

diff --git a/runtime/GuestTLS.h b/runtime/GuestTLS.h
--- a/runtime/GuestTLS.h
+++ b/runtime/GuestTLS.h
@@ -3,6 +3,8 @@
 #include <stddef.h>
 #include <stdint.h>
 #include <pthread.h>
+// Opt-in metadata for storage allocated by this module; never reads its contents.
+void gt_set_lifetime_trace(bool enabled);
 typedef struct {
     void *bytes;
     size_t size, alignment;
diff --git a/runtime/GuestTLS.c b/runtime/GuestTLS.c
--- a/runtime/GuestTLS.c
+++ b/runtime/GuestTLS.c
@@ -1,6 +1,33 @@
 #include "GuestTLS.h"
 #include <stdlib.h>
 #include <string.h>
+#include <inttypes.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <time.h>
+static atomic_bool trace_lifetime;
+static atomic_uint lifetime_records;
+void gt_set_lifetime_trace(bool enabled) { atomic_store(&trace_lifetime,enabled); }
+static void trace_storage(const char *event,uintptr_t address,size_t size) {
+    if(!atomic_load(&trace_lifetime))return;
+    unsigned sequence=atomic_fetch_add(&lifetime_records,1);
+    if(sequence>4096)return;
+    uint64_t thread=0;pthread_threadid_np(NULL,&thread);
+    struct timespec now={0};clock_gettime(CLOCK_MONOTONIC,&now);
+    char line[256];
+    int n=snprintf(line,sizeof line,"[host-tls] uptime_ms=%llu event=%s thread=%llu pointer=0x%" PRIxPTR " size=%zu\n",
+        (unsigned long long)((uint64_t)now.tv_sec*1000+(uint64_t)now.tv_nsec/1000000),
+        sequence==4096?"trace-limit":event,(unsigned long long)thread,address,size);
+    if(n>0 && (size_t)n<sizeof line)(void)write(STDERR_FILENO,line,(size_t)n);
+}
+__attribute__((noinline)) static void release_storage(void *storage) {
+    uintptr_t address=(uintptr_t)storage;
+    trace_storage("release-begin",address,0);
+    free(storage);
+    trace_storage("release-end",address,0);
+}
+
 bool gt_create(GuestTLS *tls, const void *bytes, size_t size, size_t alignment,
                uintptr_t descriptors, size_t descriptors_size) {
     if (tls->initialized || !bytes || !size || size>16*1024*1024 || !alignment ||
@@ -11,7 +38,7 @@
     staged.bytes=malloc(size);
     if (!staged.bytes) return false;
     memcpy(staged.bytes,bytes,size);
-    if (pthread_key_create(&staged.key,free)) { free(staged.bytes); return false; }
+    if (pthread_key_create(&staged.key,release_storage)) { free(staged.bytes); return false; }
     staged.initialized=true; *tls=staged; return true;
 }
 void *gt_address(GuestTLS *tls, const uint64_t descriptor[3]) {
@@ -23,6 +50,7 @@
         if (posix_memalign(&storage,tls->alignment,tls->size)) return NULL;
         memcpy(storage,tls->bytes,tls->size);
         if (pthread_setspecific(tls->key,storage)) { free(storage); return NULL; }
+        trace_storage("allocate",(uintptr_t)storage,tls->size);
     }
     return (char *)storage+descriptor[2];
 }
@@ -45,7 +73,7 @@
 }
 void gt_destroy(GuestTLS *tls) {
     if (tls->initialized) {
-        free(pthread_getspecific(tls->key)); pthread_setspecific(tls->key,NULL);
+        release_storage(pthread_getspecific(tls->key)); pthread_setspecific(tls->key,NULL);
         pthread_key_delete(tls->key); free(tls->bytes);
     }
     *tls=(GuestTLS){0};
