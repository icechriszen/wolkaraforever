+static void memory_permission_record(WKMemoryEvent event, void *caller) {
+    int saved=errno;
+    uintptr_t pc=(uintptr_t)__builtin_extract_return_addr(caller);
+    const GuestLibrary *library=gl_library_at(&carried,pc);
+    if(library) {
+        event.caller_image=2+(int)(library-carried.libraries);
+        event.caller_offset=pc-(uintptr_t)(library->image.header_address+library->slide);
+    } else if(inside((void *)pc,1)) {
+        event.caller_image=1;
+        event.caller_offset=pc-(uintptr_t)guest.arena.executable;
+    }
+    event.arena=inside((void *)(event.operation==WK_MEMORY_MAP?event.result:event.address),event.size);
+    wk_memory_trace_record(event);
+    errno=saved;
+}
