+            assert(down.type==NSEventTypeLeftMouseDown && up.type==NSEventTypeLeftMouseUp);
+            assert(CGPointEqualToPoint(down.locationInWindow,expected) && CGPointEqualToPoint(up.locationInWindow,expected));
+        }
+    }
     [defaults removeObjectForKey:@"WolkaraForeverInterfaceModeV1"];
