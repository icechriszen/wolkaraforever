+        [defaults setObject:mode forKey:@"WolkaraForeverInterfaceModeV1"];
+        BOOL mobile = ![mode isEqualToString:@"ipados"] &&
+            (![mode isEqualToString:@"auto"] || UIDevice.currentDevice.userInterfaceIdiom == UIUserInterfaceIdiomPhone);
+        UIView *tapHost = [[NSClassFromString(@"AKHostView") alloc] initWithFrame:CGRectMake(0,0,874,402)];
+        [tapHost setValue:window forKey:@"nsWindow"];
