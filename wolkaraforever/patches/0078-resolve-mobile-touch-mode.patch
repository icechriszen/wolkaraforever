+@interface FixtureFinger : NSObject
+@property CGPoint point;
+@property UITouchPhase phase;
+@property(weak) UIView *view;
+@end
+@implementation FixtureFinger
+- (UITouchType)type { return UITouchTypeDirect; }
+- (CGPoint)locationInView:(UIView *)view { (void)view; return self.point; }
+@end
+@interface FixtureFingerEvent : NSObject
+@property NSSet *allTouches;
+@end
+@implementation FixtureFingerEvent
+- (UIEventButtonMask)buttonMask { return 0; }
